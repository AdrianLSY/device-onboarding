{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-left": 0,
    "margin-bottom": 0,
    "margin-right": 0,
    "spacing": 0,
    "modules-left": [
        "custom/logo",
        "custom/app"
    ],
    "modules-center": [],
    "modules-right": [
        "group/tray",
        "cpu",
        "custom/gpu",
        "memory",
        "hyprland/workspaces",
        "custom/dropbox",
        "custom/tailscale",
        "network",
        "custom/clock"
    ],
    "custom/logo": {
        "format": "\uf303",
        "tooltip": false,
        "on-click": "vicinae 'vicinae://launch/power?toggle=true'"
    },
    "custom/app": {
        "exec": "~/.config/waybar/scripts/active-app",
        "restart-interval": 5,
        "tooltip": false
    },
    "group/tray": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": [
            "custom/tray-toggle",
            "tray"
        ]
    },
    "custom/tray-toggle": {
        "format": "\uf104",
        "tooltip": false
    },
    "tray": {
        "icon-size": 14,
        "spacing": 16,
        "show-passive-items": true,
        "reverse-direction": false
    },
    "cpu": {
        "interval": 2,
        "format": "<span size='5.5pt'>CPU</span>\n{usage}%",
        "justify": "center",
        "tooltip-format": "CPU Usage: {usage}%\nFrequency: {max_frequency}GHz",
        "on-click": "kitty -e btop"
    },
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | awk '/^[0-9]+$/ { print $1 \"%\"; ok = 1 } END { if (!ok) print \"–\" }'",
        "interval": 2,
        "format": "<span size='5.5pt'>GPU</span>\n{}",
        "justify": "center",
        "tooltip": false,
        "on-click": "kitty -e btop"
    },
    "memory": {
        "interval": 2,
        "format": "<span size='5.5pt'>RAM</span>\n{percentage}%",
        "justify": "center",
        "tooltip-format": "Memory: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)",
        "on-click": "kitty -e btop"
    },
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{name}",
        "active-only": true,
        "on-scroll-up": "hyprctl dispatch workspace e+1 1>/dev/null",
        "on-scroll-down": "hyprctl dispatch workspace e-1 1>/dev/null",
        "show-special": false
    },
    "custom/dropbox": {
        "exec": "~/.config/waybar/scripts/dropbox-status",
        "return-type": "json",
        "interval": 5,
        "on-click": "xdg-open ~/Dropbox"
    },
    "custom/tailscale": {
        "exec": "~/.config/waybar/scripts/tailscale-status",
        "return-type": "json",
        "interval": 5,
        "on-click": "flatpak run dev.deedles.Trayscale"
    },
    "network": {
        "interval": 5,
        "format-ethernet": "‹···›",
        "format-wifi": "󰖩",
        "format-linked": "‹···›",
        "format-disconnected": "󰖪",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },
    "custom/clock": {
        "exec": "date '+%a %-d %b  %-I:%M %p'",
        "interval": 1,
        "tooltip": false
    }
}
