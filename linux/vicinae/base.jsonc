// The repo's Vicinae settings. settings.json imports this file, and Vicinae
// never writes to it, so these comments stay. A change made in Vicinae's
// settings window goes to settings.json instead and wins over this file.
// Every option, with its default: `vicinae config default`.
{
	// mac-black (themes/mac-black.toml, linked into ~/.local/share/vicinae/themes
	// by setup/tweak/vicinae.sh) for both appearances: the desktop is always dark.
	"theme": {
		"light": { "name": "mac-black" },
		"dark": { "name": "mac-black" }
	},

	"launcher_window": {
		// Translucent black over the blur that hypr/hyprland.lua's layer rule gives
		// the vicinae layer, with the 12px corners of the windows.
		"opacity": 0.85,
		"rounding": 12
	},

	"providers": {
		"power": {
			"entrypoints": {
				// Nothing on this desktop answers logind's lock signal, so lock with
				// swaylock, which reads ~/.config/swaylock/config.
				"lock": { "preferences": { "customProgram": "swaylock -f" } }
			}
		},

		// Extension preferences, keyed @<author>/<extension's directory>. The
		// extensions are installed by setup/tweak/vicinae-extensions.sh.
		// Raycast's Tailscale extension runs the macOS app's binary unless given
		// the CLI's path.
		"@samlinville/store.raycast.tailscale": {
			"preferences": { "tailscalePath": "/usr/bin/tailscale" }
		},

		// The database the KeePassXC desktop app opens, synced by Dropbox. The
		// extension passes the path to keepassxc-cli without a shell, so no ~.
		// It never locks, by choice: until it locks, it keeps the database
		// password unencrypted in Vicinae's local storage,
		// ~/.local/share/vicinae/vicinae.db (a directory only this user can read).
		"@system7/store.vicinae.keepassxc": {
			"preferences": {
				"database": "/home/adrian/Dropbox/Keychain.kdbx",
				"lockAfterInactivity": "-1"
			}
		}
	}
}
